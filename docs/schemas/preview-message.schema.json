{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sethstenzel/manim-stage/docs/schemas/preview-message.schema.json",
  "title": "manim-stage PreviewMessage v1",
  "description": "One event from manim_stage.studio.PreviewService to the editor (spec §8 PreviewMessage; ADR-0010). In-process objects; this is their PreviewMessage.to_dict() form. seq is the service revision number (0 = not tied to a revision). Status: implemented.",
  "type": "object",
  "required": [
    "v",
    "type",
    "seq"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "enum": [
        "scenes",
        "changed",
        "status",
        "timeline",
        "frame",
        "log",
        "error",
        "done"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "scenes"
        },
        "file": {
          "type": "string"
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "runner-message.schema.json#/$defs/SceneInfo"
          }
        }
      },
      "required": [
        "file",
        "scenes"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "changed"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "files"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "status"
        },
        "state": {
          "enum": [
            "running",
            "done",
            "error",
            "cancelled"
          ]
        },
        "scene": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "superseded",
            "cancelled"
          ]
        },
        "settings": {
          "type": "object",
          "properties": {
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer"
            },
            "workers": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "required": [
        "state",
        "scene"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "timeline"
        },
        "scene": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$"
        },
        "timeline": {
          "$ref": "timeline.schema.json"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "scene",
        "revision",
        "timeline",
        "dependencies"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "frame"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$"
        },
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "cached": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "revision",
        "frame",
        "path",
        "cached",
        "total"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "log"
        },
        "line": {
          "type": "string"
        }
      },
      "required": [
        "line"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "error"
        },
        "message": {
          "type": "string"
        },
        "traceback": {
          "type": "string"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "message",
        "traceback",
        "file",
        "line"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "done"
        },
        "scene": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "frames_drawn": {
          "type": "integer",
          "minimum": 0
        },
        "timings": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "scene",
        "revision",
        "frames",
        "frames_drawn",
        "timings"
      ]
    }
  ]
}
