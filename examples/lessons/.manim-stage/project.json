{
  "schema": "manim_stage.project",
  "version": 1,
  "theme": {
    "colors": {
      "background": "#14181F",
      "primary": "#58C4DD",
      "secondary": "#5CD0B3",
      "accent": "#FFC857",
      "highlight": "#F0AC5F",
      "success": "#83C167",
      "warning": "#FF862F",
